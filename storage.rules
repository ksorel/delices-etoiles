rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Photos des plats ────────────────────────────────────
    match /plats/{imageId} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }

    // ─── Images boissons et menus ────────────────────────────
    match /boissons/{imageId} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }
    match /menus/{imageId} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.token.role in ['admin', 'manager'];
    }

    // ─── Documents devis traiteur ────────────────────────────
    // En pratique l'app passe toujours par la Cloud Function uploadDevisFile
    // (Admin SDK, contourne ces règles) qui valide déjà taille/type — mais un
    // appel direct au SDK Storage côté client (hors app, avec juste l'auth
    // anonyme que tout visiteur obtient automatiquement) doit être bloqué de
    // la même façon : défense en profondeur, mêmes limites que côté function.
    match /devis/{fileName} {
      allow read:  if request.auth != null
                   && request.auth.token.role == 'admin';
      allow create: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('application/pdf|application/msword|application/vnd[.]openxmlformats-officedocument[.]wordprocessingml[.]document|image/jpeg|image/png');
    }

    // ─── CV joints à une candidature (formulaire "Postuler") ──
    // Contient des infos personnelles : lecture reservée au staff (comme la
    // liste des candidatures elle-même, scopée par établissement côté Firestore).
    // Mêmes contraintes taille/type qu'au-dessus, même raison (défense en
    // profondeur contre un appel direct au SDK Storage hors app).
    match /candidatures/{fileName} {
      allow read: if request.auth != null
                  && request.auth.token.role in ['admin','manager','serveur','bar','cuisine','livreur','caissier','custom'];
      allow create: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('application/pdf|application/msword|application/vnd[.]openxmlformats-officedocument[.]wordprocessingml[.]document|image/jpeg|image/png');
    }

    // ─── Justificatifs de dépenses (comptabilité) ─────────────
    match /depenses/{fileName} {
      allow read:  if request.auth != null && request.auth.token.role in ['admin', 'manager'];
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'manager'];
    }

    // ─── Infos & Actualités (images publiques, écriture propriétaire + gérant) ─
    match /annonces/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.token.role in ['admin', 'manager'];
    }

    // ─── Carrousel d'accueil (images publiques, écriture propriétaire) ─
    match /accueil/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }

    // ─── Logos d'établissement (images publiques, écriture propriétaire + gérant de ce lieu) ─
    match /restos/{restoId}/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null
                   && (request.auth.token.role == 'admin'
                       || (request.auth.token.role == 'manager' && request.auth.token.restoId == restoId));
    }

    // ─── Fallback ────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
